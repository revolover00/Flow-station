# Server-only. Never prefix secrets with VITE_. Copy to .env.local for development.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.8-27b
AZURE_TRANSLATOR_KEY=
# Set for regional resources; empty for single-service global resources.
AZURE_TRANSLATOR_REGION=
# Public Google Programmable Search Engine ID (cx), not a JSON API key.
GOOGLE_CSE_ID=
# Optional private pilot access code for metered endpoints. Required on Vercel when connecting metered keys unless explicitly opted into public access.
FLOW_ACCESS_CODE=
ALLOW_PUBLIC_AI=false
